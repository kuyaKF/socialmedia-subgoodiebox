PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/social-boilerplate
JWT_SECRET=changeme
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin

# PayMongo — use TEST keys (sk_test_.../whsec_...) during development. Never commit live keys.
PAYMONGO_SECRET_KEY=sk_test_replace_me
# Three separate webhooks are registered in the PayMongo dashboard (one-time subscription
# checkout, Goodie Box orders, recurring subscription billing), each with its own signing
# secret — they are NOT interchangeable.
PAYMONGO_WEBHOOK_SECRET=whsec_replace_me
PAYMONGO_GOODIE_BOX_WEBHOOK_SECRET=whsec_replace_me

# Recurring billing (PayMongo Subscriptions API) — optional, only needed once PayMongo support
# has enabled Subscriptions on this account (it is NOT self-serve/on-by-default) and the three
# Plan resources have been created via `npx ts-node src/scripts/createPaymongoPlans.ts`. Only
# card and Maya support automatic recurring charges; GCash/QRPH/manual-card users are unaffected
# and keep using the checkout flow above.
PAYMONGO_SUBSCRIPTION_WEBHOOK_SECRET=whsec_replace_me
PAYMONGO_PLAN_ID_STARTER=plan_replace_me
PAYMONGO_PLAN_ID_PLUS=plan_replace_me
PAYMONGO_PLAN_ID_PREMIUM=plan_replace_me

# Resend — used to send email verification links. Get an API key at resend.com.
RESEND_API_KEY=re_replace_me
# onboarding@resend.dev works with no domain setup for local dev. Use a verified sender on
# your own domain before going live.
EMAIL_FROM=Haven Circle <onboarding@resend.dev>

# Cloudinary — used to host blog post images. Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
