PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/social-boilerplate
JWT_SECRET=changeme
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin

# PayMongo — use TEST keys (sk_test_.../whsec_...) during development. Never commit live keys.
PAYMONGO_SECRET_KEY=sk_test_replace_me
# Two separate webhooks are registered in the PayMongo dashboard (subscriptions vs. Goodie Box
# orders), each with its own signing secret — they are NOT interchangeable.
PAYMONGO_WEBHOOK_SECRET=whsec_replace_me
PAYMONGO_GOODIE_BOX_WEBHOOK_SECRET=whsec_replace_me

# Resend — used to send email verification links. Get an API key at resend.com.
RESEND_API_KEY=re_replace_me
# onboarding@resend.dev works with no domain setup for local dev. Use a verified sender on
# your own domain before going live.
EMAIL_FROM=Haven Circle <onboarding@resend.dev>

# Cloudinary — used to host blog post images. Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
